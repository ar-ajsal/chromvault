# ─── Server ──────────────────────────────────────────────
PORT=5000

# ─── Database ────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://user:password@host:27017/chromvault?ssl=true&authSource=admin&retryWrites=true&w=majority

# ─── Auth ────────────────────────────────────────────────
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# ─── Cloudinary (image uploads) ──────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Razorpay (payments) ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: set when you configure a Razorpay webhook for server-side payment confirmation
RAZORPAY_WEBHOOK_SECRET=

# ─── Google Maps (currently unused by the app) ───────────
VITE_GOOGLE_MAPS_API_KEY=

# ─── CORS ────────────────────────────────────────────────
# Comma-separated list of allowed origins (storefront + admin). No trailing slash.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173
